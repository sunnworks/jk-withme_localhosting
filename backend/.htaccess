# =====================================================================
#  백엔드 보안 (Apache)
# =====================================================================

# --- 민감/내부 파일 직접 접근 차단 ---
#  외부에서 직접 호출할 필요가 있는 건 submit.php 와 admin/ 뿐.
#  나머지 include·설정·데이터 파일은 모두 차단.
<FilesMatch "\.(sql|md|sqlite|db|log|ini|sample\.php)$">
    Require all denied
</FilesMatch>
<Files "config.php">
    Require all denied
</Files>
<Files "db.php">
    Require all denied
</Files>
<Files "mailer.php">
    Require all denied
</Files>
<Files "security.php">
    Require all denied
</Files>

# --- 디렉터리 목록 노출 차단 ---
Options -Indexes

# --- 보안 헤더 ---
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
    # 관리자/폼 응답 캐시 방지는 각 PHP에서 처리
</IfModule>
