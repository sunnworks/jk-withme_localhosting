{"id":3878,"date":"2026-01-07T15:01:52","date_gmt":"2026-01-07T06:01:52","guid":{"rendered":"https:\/\/www.jk-withme.com\/?page_id=3878"},"modified":"2026-01-07T15:23:16","modified_gmt":"2026-01-07T06:23:16","slug":"notice","status":"publish","type":"page","link":"https:\/\/www.jk-withme.com\/notice\/","title":{"rendered":"JK \uac1c\uc778\uc815\ubcf4 \ucc98\ub9ac\ubc29\uce68"},"content":{"rendered":"\n\n\t\t\tJKWITHME Plastic Surgery \u00b7 Dermatology\n\t\t<h2>\n\t\t\tJK\uc704\ub4dc\ubbf8\uc758\uc6d0 \uac1c\uc778\uc815\ubcf4 \ucc98\ub9ac\ubc29\uce68\n\t\t<\/h2>\n\t\t\t<p>JK\uc704\ub4dc\ubbf8\ub294 \uace0\uac1d\ub2d8\uc758 \uc18c\uc911\ud55c \uac1c\uc778\uc815\ubcf4\ub97c \ucd5c\uc6b0\uc120\uc73c\ub85c \ubcf4\ud638\ud558\uba70, \uad00\ub828 \ubc95\ub839\uc744 \uc5c4\uaca9\ud788 \uc900\uc218\ud569\ub2c8\ub2e4.<\/p>\t\t\n\t\t\t<a href=\"#forms\"  target=\"_self\">\n\t\t\t\t\t\t\t\uc0c1\ub2f4 \uc608\uc57d \ubc0f \ubb38\uc758\ud558\uae30\n\t\t\t\t\t<\/a>\n\t\t\n\t\t\t<p>JK With Me Plastic Surgery &amp; Dermatology<\/p>\t\t\n\t\t\n\t\t\t<p>JK\uc704\ub4dc\ubbf8\uc758\uc6d0 \uac1c\uc778\uc815\ubcf4 \ucc98\ub9ac\ubc29\uce68<\/p>\t\t\n\t\t\n\t\t\t\uc758\ub8cc\ubc95\uc778 \uc815\uac15\uc758\ub8cc\uc7ac\ub2e8 JK\uc704\ub4dc\ubbf8\uc758\uc6d0 (\uc774\ud558 &#8216;\ubcf8\uc6d0&#8217;\uc774\ub77c \ud569\ub2c8\ub2e4)\uc740 \uc774\uc6a9\uc790\uc758 \uac1c\uc778\uc815\ubcf4\ub97c \uc18c\uc911\ud558\uac8c \uc5ec\uae30\uba70, \u300c\uac1c\uc778\uc815\ubcf4 \ubcf4\ud638\ubc95\u300d \ubc0f \uad00\ub828 \ubc95\ub839\uc744 \uc900\uc218\ud558\uc5ec \uace0\uac1d\ub2d8\uc758 \uad8c\uc775\uc744 \ubcf4\ud638\ud558\uace0 \uc774\uc640 \uad00\ub828\ud55c \uace0\ucda9\uc744 \uc2e0\uc18d\ud558\uace0 \uc6d0\ud65c\ud558\uac8c \ucc98\ub9ac\ud560 \uc218 \uc788\ub3c4\ub85d \ub2e4\uc74c\uacfc \uac19\uc740 \ucc98\ub9ac\ubc29\uce68\uc744 \ub450\uace0 \uc788\uc2b5\ub2c8\ub2e4.\t\t\n\t\t\n\t\t\t\uc81c1\uc870 (\uc218\uc9d1\ud558\ub294 \uac1c\uc778\uc815\ubcf4\uc758 \ud56d\ubaa9 \ubc0f \uc218\uc9d1\ubc29\ubc95)\t\t\n\t\t\n\t\t\t\ubcf8\uc6d0\uc740 \uc9c4\ub8cc \uc11c\ube44\uc2a4 \uc81c\uacf5 \ubc0f \ud648\ud398\uc774\uc9c0 \ud68c\uc6d0\uac00\uc785\uc744 \uc704\ud574 \ud544\uc694\ud55c \ucd5c\uc18c\ud55c\uc758 \uac1c\uc778\uc815\ubcf4\ub97c \uc218\uc9d1\ud569\ub2c8\ub2e4.<b data-path-to-node=\"8\" data-index-in-node=\"0\">1. \uc9c4\ub8cc \uc2dc \uc218\uc9d1\ud56d\ubaa9 (\uc758\ub8cc\ubc95\uc5d0 \ub530\ub978 \uc758\ubb34 \uc218\uc9d1)<\/b><ul data-path-to-node=\"9\"><li><b data-path-to-node=\"9,0,0\" data-index-in-node=\"0\">\ud544\uc218\ud56d\ubaa9:<\/b> \uc131\uba85, \uc8fc\ubbfc\ub4f1\ub85d\ubc88\ud638(\uc678\uad6d\uc778\ub4f1\ub85d\ubc88\ud638), \uc8fc\uc18c, \uc804\ud654\ubc88\ud638, \ud734\ub300\uc804\ud654\ubc88\ud638, \uc774\uba54\uc77c<\/li><li><b data-path-to-node=\"9,1,0\" data-index-in-node=\"0\">\uac74\uac15\uc815\ubcf4:<\/b> \ubcd1\ub825, \uac00\uc871\ub825 \ub4f1 \uc9c4\ub8cc \uc11c\ube44\uc2a4 \uc81c\uacf5\uc744 \uc704\ud574 \uc758\ub8cc\uc9c4\uc774 \ud544\uc694\ud558\ub2e4\uace0 \ud310\ub2e8\ud558\ub294 \uc815\ubcf4<\/li><\/ul><b data-path-to-node=\"10\" data-index-in-node=\"0\">2. \ud648\ud398\uc774\uc9c0 \ud68c\uc6d0\uac00\uc785 \ubc0f \uc11c\ube44\uc2a4 \uc774\uc6a9 \uc2dc \uc218\uc9d1\ud56d\ubaa9<\/b><ul data-path-to-node=\"11\"><li><b data-path-to-node=\"11,0,0\" data-index-in-node=\"0\">\ud544\uc218\ud56d\ubaa9:<\/b> \uc544\uc774\ub514, \ube44\ubc00\ubc88\ud638, \uc774\ub984, \ud734\ub300\uc804\ud654\ubc88\ud638, \uc774\uba54\uc77c<\/li><li><b data-path-to-node=\"11,1,0\" data-index-in-node=\"0\">\uc120\ud0dd\ud56d\ubaa9:<\/b> SMS\/\uc774\uba54\uc77c \uc218\uc2e0 \uc5ec\ubd80<\/li><li><b data-path-to-node=\"11,2,0\" data-index-in-node=\"0\">\ubbfc\uac10\uc815\ubcf4:<\/b> \uacfc\uac70 \ubcd1\ub825, \uc218\uc220 \uc774\ub825, \uad00\uc2ec \uc218\uc220 \ubd84\uc57c (\uc0c1\ub2f4 \ubc0f \ub9de\ucda4 \uc11c\ube44\uc2a4 \uc81c\uacf5\uc6a9)<\/li><li><b data-path-to-node=\"11,3,0\" data-index-in-node=\"0\">\uc790\ub3d9 \uc218\uc9d1:<\/b> \uc11c\ube44\uc2a4 \uc774\uc6a9 \uae30\ub85d, \uc811\uc18d \ub85c\uadf8, \ucfe0\ud0a4(Cookie), \uc811\uc18d IP \uc815\ubcf4<\/li><\/ul><b data-path-to-node=\"12\" data-index-in-node=\"0\">3. \uc218\uc9d1 \ubc29\ubc95<\/b>\ud648\ud398\uc774\uc9c0(\ud68c\uc6d0\uac00\uc785, \uc0c1\ub2f4, \uc608\uc57d, \ud6c4\uae30 \ub4f1), \uc11c\uba74 \uc591\uc2dd, \ud329\uc2a4, \uc804\ud654, \uc774\uba54\uc77c, \uce74\uce74\uc624\ud1a1 \uc0c1\ub2f4\t\t\n\t\t\n\t\t\t\uc81c2\uc870 (\uac1c\uc778\uc815\ubcf4\uc758 \uc218\uc9d1 \ubc0f \uc774\uc6a9\ubaa9\uc801)\t\t\n\t\t\n\t\t\t\ubcf8\uc6d0\uc740 \uc218\uc9d1\ud55c \uc815\ubcf4\ub97c \ub2e4\uc74c\uc758 \ubaa9\uc801\uc744 \uc704\ud574\uc11c\ub9cc \ud65c\uc6a9\ud558\uba70, \ubaa9\uc801 \ubcc0\uacbd \uc2dc \uc0ac\uc804 \ub3d9\uc758\ub97c \uad6c\ud569\ub2c8\ub2e4.<ul data-path-to-node=\"17\"><li><b data-path-to-node=\"17,0,0\" data-index-in-node=\"0\">\uc9c4\ub8cc \uc11c\ube44\uc2a4:<\/b> \uc9c4\ub2e8, \uce58\ub8cc, \uc9c4\ub8cc\ube44 \uc218\ub0a9\/\uccad\uad6c\/\ud658\uae09, \uc81c\uc99d\uba85 \ubc1c\uc1a1<\/li><li><b data-path-to-node=\"17,1,0\" data-index-in-node=\"0\">\ud68c\uc6d0 \uad00\ub9ac:<\/b> \ubcf8\uc778 \ud655\uc778, \uc9c4\ub8cc \uc608\uc57d \ubc0f \uc870\ud68c, \uace0\uc9c0\uc0ac\ud56d \uc804\ub2ec, \ubd88\ub9cc \ucc98\ub9ac<\/li><li><b data-path-to-node=\"17,2,0\" data-index-in-node=\"0\">\ub9c8\ucf00\ud305 \ubc0f \ud2b9\ud654 \uc11c\ube44\uc2a4:<\/b> \uc0c8\ub85c\uc6b4 \uc11c\ube44\uc2a4\/\uc774\ubca4\ud2b8 \uc815\ubcf4 \uc548\ub0b4, 3D \ucd08\uc74c\ud30c \uae30\ubc18 \ub9de\ucda4\ud615 \ubc14\ub514 \ucee8\uc124\ud305, \ube44\ub9cc \ucc98\ubc29 \uc2dc\uc2a4\ud15c \uc548\ub0b4, \uc124\ubb38\uc870\uc0ac<\/li><\/ul>\t\t\n\t\t\n\t\t\t\uc81c3\uc870 (\uac1c\uc778\uc815\ubcf4\uc758 \ubcf4\uc720 \ubc0f \uc774\uc6a9\uae30\uac04)\t\t\n\t\t\n\t\t\t\uad00\ub828 \ubc95\ub839\uc5d0 \uc758\uac70\ud558\uc5ec \uaddc\uc815\ub41c \ubcf4\uc874 \uae30\uac04 \ub3d9\uc548 \uac1c\uc778\uc815\ubcf4\ub97c \ubcf4\uc720\ud569\ub2c8\ub2e4.<ul data-path-to-node=\"21\"><li><b data-path-to-node=\"21,0,0\" data-index-in-node=\"0\">\ud68c\uc6d0 \uac00\uc785 \uc815\ubcf4:<\/b> \ud68c\uc6d0 \ud0c8\ud1f4 \uc2dc \ud639\uc740 \ucd5c\uc885 \ub85c\uadf8\uc778\uc73c\ub85c\ubd80\ud130 1\ub144 \uacbd\uacfc \uc2dc\uae4c\uc9c0<\/li><li><b data-path-to-node=\"21,1,0\" data-index-in-node=\"0\">\uc9c4\ub8cc \uae30\ub85d:<\/b> \u300e\uc758\ub8cc\ubc95\u300f\uc5d0 \uc900\ud558\uc5ec \ubcf4\uc874 (\ud658\uc790 \uba85\ubd80 5\ub144, \uc9c4\ub8cc\uae30\ub85d\ubd80 10\ub144)<\/li><li><b data-path-to-node=\"21,2,0\" data-index-in-node=\"0\">\uacb0\uc81c \ubc0f \ubcf8\uc778 \ud655\uc778 \uae30\ub85d:<\/b> \uc2e0\uc6a9\uc815\ubcf4(3\ub144), \ubcf8\uc778 \ud655\uc778(6\uac1c\uc6d4), \ubc29\ubb38 \uae30\ub85d(3\uac1c\uc6d4)<\/li><\/ul>\t\t\n\t\t\n\t\t\t\uc81c4\uc870 (\uac1c\uc778\uc815\ubcf4 \ucc98\ub9ac \uc5c5\ubb34\uc758 \uc704\ud0c1)\t\t\n\t\t\n\t\t\t\ubcf8\uc6d0\uc740 \uc6d0\ud65c\ud55c \uc11c\ube44\uc2a4 \uc81c\uacf5\uc744 \uc704\ud574 \ub2e4\uc74c\uacfc \uac19\uc774 \uac1c\uc778\uc815\ubcf4 \ucc98\ub9ac \uc5c5\ubb34\ub97c \uc678\ubd80 \uc804\ubb38\uc5c5\uccb4\uc5d0 \uc704\ud0c1\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4.<ul data-path-to-node=\"25\"><li><b data-path-to-node=\"25,0,0\" data-index-in-node=\"0\">\ud06c\ub85c\uc2a4\uc5e0:<\/b> \ud648\ud398\uc774\uc9c0 \uac1c\ubc1c \ubc0f \uc6b4\uc601 \uad00\ub9ac<\/li><li><b data-path-to-node=\"25,1,0\" data-index-in-node=\"0\">\uc5d8\ub9bc\ub137:<\/b> \uac1c\uc778\uc815\ubcf4 \uc554\ud638\ud654 \ubc0f \ubcf4\uc548 \uc720\uc9c0<\/li><li><b data-path-to-node=\"25,2,0\" data-index-in-node=\"0\">\ub2e4\uc19c\uc2dc\uc2a4\ud15c:<\/b> \ucc98\ubc29\/\uc804\uc0b0 \uc2dc\uc2a4\ud15c \uc720\uc9c0\ubcf4\uc218 \ubc0f \ubcf4\uc548<\/li><\/ul>\t\t\n\t\t\n\t\t\t\uc81c5\uc870 (\uac1c\uc778\uc815\ubcf4\uc758 \ud30c\uae30\uc808\ucc28 \ubc0f \ubc29\ubc95)\t\t\n\t\t\n\t\t\t\uc218\uc9d1 \ubaa9\uc801 \ub2ec\uc131 \uc2dc \ud639\uc740 \ubcf4\uc720 \uae30\uac04 \uacbd\uacfc \uc2dc 5\uc77c \uc774\ub0b4\uc5d0 \ud30c\uae30\ud569\ub2c8\ub2e4.<ul data-path-to-node=\"29\"><li><b data-path-to-node=\"29,0,0\" data-index-in-node=\"0\">\uc804\uc790\uc801 \ud30c\uc77c:<\/b> \ubcf5\uad6c\uac00 \ubd88\uac00\ub2a5\ud55c \uae30\uc220\uc801 \ubc29\ubc95\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc0ad\uc81c<\/li><li><b data-path-to-node=\"29,1,0\" data-index-in-node=\"0\">\uc885\uc774 \ubb38\uc11c:<\/b> \ubd84\uc1c4\uae30\ub85c \ubd84\uc1c4\ud558\uac70\ub098 \uc18c\uac01 \ucc98\ub9ac<\/li><\/ul>\t\t\n\t\t\n\t\t\t\uc81c6\uc870 (\uc601\uc0c1\uc815\ubcf4\ucc98\ub9ac\uae30\uae30 \uc6b4\uc601 \ubc0f \uad00\ub9ac)\t\t\n\t\t\n\t\t\t\ubcf8\uc6d0\uc740 \uc2dc\uc124 \uc548\uc804 \ubc0f \ubc94\uc8c4 \uc608\ubc29\uc744 \uc704\ud574 \uc601\uc0c1\uc815\ubcf4\ucc98\ub9ac\uae30\uae30\ub97c \uc6b4\uc601\ud569\ub2c8\ub2e4.<ul data-path-to-node=\"33\"><li><b data-path-to-node=\"33,0,0\" data-index-in-node=\"0\">\uc124\uce58 \ub300\uc218:<\/b> \ucd1d 16\ub300 (\ubcf8\uad00 \ub0b4\ubd80 11\ub300, \uc678\ubd80 5\ub300)<\/li><li><b data-path-to-node=\"33,1,0\" data-index-in-node=\"0\">\ucd2c\uc601 \uc2dc\uac04:<\/b> 24\uc2dc\uac04 \uc0c1\uc2dc \ucd2c\uc601<\/li><li><b data-path-to-node=\"33,2,0\" data-index-in-node=\"0\">\uad00\ub9ac\ucc45\uc784\uc790:<\/b> \ubc15\uc2b9\ucca0 (070-4852-3822)<\/li><\/ul>\t\t\n\t\t\n\t\t\t\uc81c7\uc870 (\uac1c\uc778\uc815\ubcf4\uc758 \uc548\uc804\uc131 \ud655\ubcf4 \uc870\uce58)\t\t\n\t\t\n\t\t\t\ubcf8\uc6d0\uc740 \uac1c\uc778\uc815\ubcf4 \ubcf4\ud638\ub97c \uc704\ud574 \ub2e4\uc74c\uacfc \uac19\uc740 \uc870\uce58\ub97c \ucde8\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4.<ul data-path-to-node=\"37\"><li><b data-path-to-node=\"37,0,0\" data-index-in-node=\"0\">\uad00\ub9ac\uc801 \uc870\uce58:<\/b> \ub0b4\ubd80\uad00\ub9ac\uacc4\ud68d \uc218\ub9bd, \uac1c\uc778\uc815\ubcf4 \ucde8\uae09 \uc9c1\uc6d0 \ucd5c\uc18c\ud654 \ubc0f \uc815\uae30 \uad50\uc721<\/li><li><b data-path-to-node=\"37,1,0\" data-index-in-node=\"0\">\uae30\uc220\uc801 \uc870\uce58:<\/b> \ube44\ubc00\ubc88\ud638 \uc554\ud638\ud654, \ubcf4\uc548 \ud504\ub85c\uadf8\ub7a8 \uc124\uce58, \ud574\ud0b9 \ub300\ube44 \uc811\uadfc \ud1b5\uc81c \uc2dc\uc2a4\ud15c \uc6b4\uc6a9<\/li><li><b data-path-to-node=\"37,2,0\" data-index-in-node=\"0\">\ubb3c\ub9ac\uc801 \uc870\uce58:<\/b> \uac1c\uc778\uc815\ubcf4 \ubcf4\uad00 \uc7a5\uc18c\uc758 \ucd9c\uc785 \ud1b5\uc81c \ubc0f \uc7a0\uae08\uc7a5\uce58 \uc124\uce58<\/li><\/ul>\t\t\n\t\t\n\t\t\t\uc81c8\uc870 (\uac1c\uc778\uc815\ubcf4 \ubcf4\ud638\ucc45\uc784\uc790 \ubc0f \uc0c1\ub2f4 \uc548\ub0b4)\t\t\n\t\t\n\t\t\t\uace0\uac1d\ub2d8\uc758 \uac1c\uc778\uc815\ubcf4 \uad00\ub828 \ubbfc\uc6d0\uc744 \ucc98\ub9ac\ud558\uae30 \uc704\ud574 \uc544\ub798\uc640 \uac19\uc774 \ucc45\uc784\uc790\ub97c \uc9c0\uc815\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4.<ul data-path-to-node=\"41\"><li><b data-path-to-node=\"41,0,0\" data-index-in-node=\"0\">\uac1c\uc778\uc815\ubcf4 \uad00\ub9ac\ucc45\uc784\uc790:<\/b> \ubc15\uc2b9\ucca0 (070-4852-3822 \/ parkkim99@hanmail.net)<\/li><li><b data-path-to-node=\"41,1,0\" data-index-in-node=\"0\">\uace0\uac1d\uc11c\ube44\uc2a4 \ub2f4\ub2f9:<\/b> \uac15\uc9c0\ud61c (032-715-7991)<\/li><li><b data-path-to-node=\"41,2,0\" data-index-in-node=\"0\">\ud648\ud398\uc774\uc9c0 \uc11c\ube44\uc2a4 \ub2f4\ub2f9:<\/b> \ubc15\ud61c\uc9c0 (070-5086-6730)<\/li><\/ul>\t\t\n\t\t\n\t\t\t\uc81c8\uc870 (\uac1c\uc778\uc815\ubcf4 \ubcf4\ud638\ucc45\uc784\uc790 \ubc0f \uc0c1\ub2f4 \uc548\ub0b4)\t\t\n\t\t\n\t\t\t\uace0\uac1d\ub2d8\uc758 \uac1c\uc778\uc815\ubcf4 \uad00\ub828 \ubbfc\uc6d0\uc744 \ucc98\ub9ac\ud558\uae30 \uc704\ud574 \uc544\ub798\uc640 \uac19\uc774 \ucc45\uc784\uc790\ub97c \uc9c0\uc815\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4.<ul data-path-to-node=\"41\"><li><b data-path-to-node=\"41,0,0\" data-index-in-node=\"0\">\uac1c\uc778\uc815\ubcf4 \uad00\ub9ac\ucc45\uc784\uc790:<\/b> \ubc15\uc2b9\ucca0 (070-4852-3822 \/ parkkim99@hanmail.net)<\/li><li><b data-path-to-node=\"41,1,0\" data-index-in-node=\"0\">\uace0\uac1d\uc11c\ube44\uc2a4 \ub2f4\ub2f9:<\/b> \uac15\uc9c0\ud61c (032-715-7991)<\/li><li><b data-path-to-node=\"41,2,0\" data-index-in-node=\"0\">\ud648\ud398\uc774\uc9c0 \uc11c\ube44\uc2a4 \ub2f4\ub2f9:<\/b> \ubc15\ud61c\uc9c0 (070-5086-6730)<\/li><\/ul>\t\t\n\n","protected":false},"excerpt":{"rendered":"<p>JKWITHME Plastic Surgery \u00b7 Dermatology JK\uc704\ub4dc\ubbf8\uc758\uc6d0 \uac1c\uc778\uc815\ubcf4 \ucc98\ub9ac\ubc29\uce68 JK\uc704\ub4dc\ubbf8\ub294 \uace0\uac1d\ub2d8\uc758 \uc18c\uc911\ud55c \uac1c\uc778\uc815\ubcf4\ub97c \ucd5c\uc6b0\uc120\uc73c\ub85c \ubcf4\ud638\ud558\uba70, \uad00\ub828 \ubc95\ub839\uc744 \uc5c4\uaca9\ud788 \uc900\uc218\ud569\ub2c8\ub2e4. \uc0c1\ub2f4 \uc608\uc57d \ubc0f \ubb38\uc758\ud558\uae30 JK With Me Plastic Surgery &amp; Dermatology JK\uc704\ub4dc\ubbf8\uc758\uc6d0 \uac1c\uc778\uc815\ubcf4 \ucc98\ub9ac\ubc29\uce68 \uc758\ub8cc\ubc95\uc778 \uc815\uac15\uc758\ub8cc\uc7ac\ub2e8 JK\uc704\ub4dc\ubbf8\uc758\uc6d0 (\uc774\ud558 &#8216;\ubcf8\uc6d0&#8217;\uc774\ub77c \ud569\ub2c8\ub2e4)\uc740 \uc774\uc6a9\uc790\uc758 \uac1c\uc778\uc815\ubcf4\ub97c \uc18c\uc911\ud558\uac8c \uc5ec\uae30\uba70, \u300c\uac1c\uc778\uc815\ubcf4 \ubcf4\ud638\ubc95\u300d \ubc0f \uad00\ub828 \ubc95\ub839\uc744 \uc900\uc218\ud558\uc5ec \uace0\uac1d\ub2d8\uc758 \uad8c\uc775\uc744 \ubcf4\ud638\ud558\uace0 \uc774\uc640 \uad00\ub828\ud55c \uace0\ucda9\uc744 \uc2e0\uc18d\ud558\uace0&hellip;<\/p>\n","protected":false},"author":1,"featured_media":1923,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"footnotes":""},"class_list":["post-3878","page","type-page","status-publish","has-post-thumbnail","hentry"],"yoast_head":"<!-- This site is optimized with the Yoast SEO plugin v28.1 - https:\/\/yoast.com\/product\/yoast-seo-wordpress\/ -->\n<title>JK\uc704\ub4dc\ubbf8 \uc131\ud615\uc678\uacfc \ud53c\ubd80\uacfc I \uc1a1\ub3c4\uc810<\/title>\n<meta name=\"description\" content=\"\uc1a1\ub3c4\uc810 \uc704\uce58, \uc9c4\ub8cc\uacfc\ubcc4 1:1 \ub9de\ucda4 \uc804\ub2f4\uc758\ub8cc\uc9c4, \uc131\ud615\ud53c\ubd80 \ud611\uc9c4, \uc57c\ua