# =====================================================================
#  JK위드미 - 정적 자산 캐시 & 압축 (성능 최적화)
#  안전: 각 기능을 <IfModule>로 감쌌기 때문에, 호스팅에 해당 모듈이
#        없으면 그냥 무시됩니다(500 에러 안 남).
#  주의: HTML은 캐시하지 않으므로 수정 시 즉시 반영됩니다.
# =====================================================================

# ---------------------------------------------------------------------
# 1) 압축 (gzip) — HTML/CSS/JS/폰트/SVG 전송 용량 축소
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2 application/vnd.ms-fontobject
</IfModule>

# ---------------------------------------------------------------------
# 2) 브라우저 캐시 만료 (mod_expires)
#    - 이미지·영상·폰트: 1년 / CSS·JS: 1개월 / HTML: 캐시 안 함
# ---------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    # HTML — 항상 최신(수정 즉시 반영)
    ExpiresByType text/html                 "access plus 0 seconds"

    # 이미지
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/gif                 "access plus 1 year"
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType image/x-icon              "access plus 1 year"

    # 영상
    ExpiresByType video/mp4                 "access plus 1 year"
    ExpiresByType video/webm                "access plus 1 year"

    # CSS / JS
    ExpiresByType text/css                  "access plus 1 month"
    ExpiresByType application/javascript    "access plus 1 month"
    ExpiresByType text/javascript           "access plus 1 month"

    # 폰트
    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType font/woff                 "access plus 1 year"
    ExpiresByType font/ttf                  "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
</IfModule>

# ---------------------------------------------------------------------
# 3) Cache-Control 헤더 (mod_headers)
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
    # 정적 자산: 오래 캐시 (변경되면 파일명/버전이 바뀌므로 immutable)
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|mp4|webm|css|js|woff2|woff|ttf|eot|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # HTML: 매번 최신 확인
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------
# 4) 디렉터리 목록 노출 차단
# ---------------------------------------------------------------------
Options -Indexes
